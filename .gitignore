# macOS
.DS_Store

# Build output (regenerate with: node tools/build.mjs)
dist/

# Dependencies (reinstall with: cd tools && npm install)
node_modules/

# Python / tooling caches
__pycache__/
*.pyc
.playwright-mcp/

# Real-circuit importer download cache
tools/tracks/cache/

# your saves (mirrored by serve.py): personal, not part of the game
saves/

# Blender working files and exports (the game loads the .glb files)
*.blend
*.blend1
output/

# voice auditions and test takes (tools/voice): listening material, not part of the game
assets/voice/auditions/

# reference circuit models (dev only, licence unclear: never commit)
models/tracks/

# test screenshots
.devtest/tmp/

# marketing media (renders and footage stay local; the briefs and logs are tracked)
marketing/**/*.mp4
marketing/**/*.mov
marketing/**/*.webm
marketing/**/*.wav
marketing/**/*.mp3
marketing/footage/

# HyperFrames working files
marketing/anim/**/.hyperframes/
marketing/anim/**/renders/
